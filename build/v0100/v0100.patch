+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+MAIN = (ROOT / 'app/src/main.py').read_text(encoding='utf-8')
+SIDEBAR = (ROOT / 'app/src/ability_sidebar.py').read_text(encoding='utf-8')
+NDM = (ROOT / 'app/src/ndm_bridge.py').read_text(encoding='utf-8')
+BRAIN = (ROOT / 'app/src/brain_qwen.py').read_text(encoding='utf-8')
+MIGRATE = (ROOT / 'app/assets/storage_migrate.ps1').read_text(encoding='utf-8')
+NATIVE = (ROOT / 'app/src/native_updater.py').read_text(encoding='utf-8')
+REQ = (ROOT / 'app/requirements.txt').read_text(encoding='utf-8')
+
+assert 'APP_VERSION = "0.10.0"' in MAIN
+assert (ROOT / 'app/assets/VERSION.txt').read_text(encoding='ascii').strip() == '0.10.0'
+for name in ('美丽锁定','美丽洞察','二成功力','五成功力','美丽之神'):
+    assert name in SIDEBAR
+assert 'class AbilitySidebar' in SIDEBAR
+assert 'class AbilityAuraOverlay' in MAIN
+assert 'self.ability_hover_timer' in MAIN
+assert 'request_abilities' in MAIN
+assert 'cosmetic only' in MAIN
+
+# Startup must not invoke NDM cleanup anymore.
+startup_tail = MAIN[MAIN.index('class AppController'):]
+assert 'QTimer.singleShot(9000, lambda: self.brain_service.cleanup_ndm_leftovers' not in startup_tail
+
+# cleanup_ndm_leftovers is a no-op and must contain no destructive filesystem call.
+m = re.search(r'def cleanup_ndm_leftovers\(self, download_root\):(.*?)(?=\n    def shutdown)', BRAIN, re.S)
+assert m, 'cleanup_ndm_leftovers missing'
+cleanup = m.group(1)
+for bad in ('rglob(', '.unlink(', 'shutil.rmtree', 'os.remove(', 'Remove-Item'):
+    assert bad not in cleanup, f'destructive NDM cleanup token returned: {bad}'
+
+# NDM adoption must be exact, non-recursive and copy-only.
+assert 'root.iterdir()' in NDM
+assert 'root.rglob(' not in NDM
+assert 'shutil.move(' not in NDM
+assert 'src.unlink(' not in NDM
+assert 'matching-extension' not in NDM
+assert '_assert_controlled_destination' in NDM
+assert 'shutil.copy2' in NDM
+
+# Migration can only target the app-owned D-drive directory and refuses unknown populated targets.
+assert "$expectedTarget = [System.IO.Path]::GetFullPath('D:\\XiaoMeiliData')" in MIGRATE
+assert ".xiaomeili-storage.json" in MIGRATE
+assert 'already contains files but has no XiaoMeili safety marker' in MIGRATE
+assert 'Safety backup retained at' in MIGRATE
+
+# Native updater remains no-delete/versioned.
+for token in ('never mirrors, purges, removes, unlinks, or recursively deletes files', 'versions', 'active.json'):
+    assert token in NATIVE
+
+assert 'psutil>=' in REQ
+print('V0100_CONTRACT_PASS')
