+def convert_action_video(src, dst, max_width=420, target_fps=12):
+    """Import action-library video without touching the user's source file.
+
+    Transparent WebM is decoded through its Alpha plane directly, avoiding a
+    second chroma-key pass. WebM without Alpha and all other supported videos
+    continue through the established green-screen pipeline. Playback remains
+    the existing transparent animated WebP path, so every current state and
+    desktop-action template keeps its old behavior.
+    """
+    src = Path(src)
+    if src.suffix.lower() == ".webm":
+        try:
+            count, fps = convert_transparent_webm_to_webp(
+                src, dst, max_width=max_width, target_fps=target_fps
+            )
+            LOGGER.info("透明 WebM Alpha 直读完成: %s -> %s | %d帧 @ %.1ffps", src, dst, count, fps)
+            return count, fps, "transparent_webm"
+        except NoTransparentAlpha:
+            LOGGER.info("WebM 未检测到透明 Alpha，按原绿幕流程导入: %s", src)
+    count, fps = convert_greenscreen_video(src, dst, max_width=max_width, target_fps=target_fps)
+    return count, fps, "greenscreen"
+
