+    def _startup_step(self, state):
+        with self._startup_lock:
+            if self._startup_failed.is_set():
+                raise RuntimeError("startup already failed")
+            self._startup_state = str(state)
+            self._startup_since = time.monotonic()
+            self._startup_trace.append({"state": str(state), "time": time.time()})
+        self._event("startup_state", state=str(state))
+
+    def _emit_finished_once(self, ok, path, message):
+        with self._startup_lock:
+            if self._finished_once:
+                return
+            self._finished_once = True
+        self._running = False
+        self.finished.emit(bool(ok), str(path or ""), str(message))
+
+    def _startup_failure(self, reason):
+        with self._startup_lock:
+            if self._startup_done.is_set() or self._startup_failed.is_set():
+                return
+            self._startup_failed.set()
+            trace = list(self._startup_trace)
+        self._sampling = False
+        self._gpu_stop.set()
+        report = ""
