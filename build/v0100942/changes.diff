+"""Acceptance driver: real AppController, real settings button and real services."""
+import json
+import re
+import os
+import time
+import threading
+from pathlib import Path
+from PySide6.QtCore import QObject, QTimer
+
+
+def prepare_config(default, user):
+    source=Path(r'C:\Users\Public\XiaoMeiliData')
+    config=source/'config.json'
+    cfg=json.loads(config.read_text(encoding='utf-8-sig')) if config.is_file() else default
+    cfg['_resource_e2e']=True
+    # All mutable caches/logs/config live in the new PUBLIC root. No microphone,
+    # updater, hotkey or unrelated background feature is needed for acceptance.
+    cfg.setdefault('speech',{})['enabled']=False
+    cfg.setdefault('vision',{})['enabled']=False
+    cfg.setdefault('updates',{})['auto_check']=False
+    cfg.setdefault('brain',{})['mode']='cloud'
+    cfg.setdefault('voice',{})['mode']='cloud'
+    secret=source/'cloud/aliyun_api_key.dpapi'
+    if secret.is_file():
+        target=user/'cloud/aliyun_api_key.dpapi'
+        with target.open('xb') as f:
+            f.write(secret.read_bytes())
+    # Runtime interpreter/models are read-only inputs. The generated worker and
+    # diagnostic logs remain under the isolated data directory.
+    import speech_input
+    runtime=source/'voice_runtime/qwen3_tts'
+    speech_input.VENV_PYTHON=runtime/'.venv/Scripts/python.exe'
+    speech_input.ASR_MODEL_DIR=source/'speech/fun_asr_nano_2512'
+    speech_input.VAD_MODEL_DIR=source/'speech/fsmn_vad'
+    return cfg
+
+
+class Acceptance(QObject):
+    def __init__(self,ctl,app,user):
+        super().__init__(app)
+        self.ctl=ctl; self.app=app; self.user=Path(user)
+        self.progress=[]; self.start=time.monotonic()
+        self.timer=QTimer(self); self.timer.setSingleShot(True)
+        self.timer.timeout.connect(self.launch); self.timer.start(2500)
+        self.deadline=QTimer(self); self.deadline.setSingleShot(True)
+        self.deadline.timeout.connect(self.timeout); self.deadline.start(360000)
+
+    def write(self,name,payload):
+        with (self.user/name).open('x',encoding='utf-8') as f:
+            json.dump(payload,f,ensure_ascii=False,indent=2)
+
+    def launch(self):
+        self.ctl.open_settings()
+        dialog=self.ctl.settings
+        dialog.open_system_section('资源占用')
+        # This emits the exact signal connected to the user's actual button.
+        dialog.v01005_diag_btn.click()
+        runner=dialog._v01005_diag_runner
+        runner.progress_changed.connect(self.on_progress)
+        runner.finished.connect(self.done)
+        self.runner=runner
+        if os.environ.get('XM_RESOURCE_E2E_CRASH')=='1':
+            self.crash_timer=QTimer(self)
+            self.crash_timer.timeout.connect(self.crash_when_ready)
+            self.crash_timer.start(100)
+
+    def crash_when_ready(self):
+        if self.runner._startup_done.is_set():
+            self.crash_timer.stop()
+            self.write('crash_host.json',{'pid':os.getpid(),'session':str(self.runner.session_dir),
+                                       'ready':True,'elapsed':time.monotonic()-self.start})
+
+    def on_progress(self,value,text):
+        self.progress.append({'value':int(value),'text':str(text),'t':time.monotonic()-self.start,
+                              'ui_value':self.ctl.settings.v01005_diag_progress.value()})
+
+    def done(self,ok,path,message):
+        self.deadline.stop()
+        self.write('e2e_result.json',{'ok':bool(ok),'report':str(path),'message':str(message),
+                                    'progress':self.progress,'session':str(self.runner.session_dir),
+                                    'startup_trace':self.runner._startup_trace,
+                                    'tts_status':re.sub(r'sk-[A-Za-z0-9]+','[redacted]',self.runner._tts_result[1])[:500]})
+        # Clicking a production diagnostic does not exit the application. Keep
+        # the same behavior and prove ten seconds of healthy UI after completion.
+        # The external harness owns later test-process cleanup.
+        self.health_timer=QTimer(self); self.health_timer.setSingleShot(True)
+        self.health_timer.timeout.connect(self.after_completion)
+        self.health_timer.start(10000)
+
+    def after_completion(self):
+        self.write('post_completion.json',{
+            'host_pid':os.getpid(),'ui_value':self.ctl.settings.v01005_diag_progress.value(),
+            'button_enabled':self.ctl.settings.v01005_diag_btn.isEnabled(),
+            'tts_active':bool(self.ctl.voice_service.cloud_stream_in_progress()),
+            'monitor_exit_code':self.runner._watchdog_proc.poll() if self.runner._watchdog_proc else None,
+            'elapsed':time.monotonic()-self.start})
+
+    def timeout(self):
+        self.write('e2e_timeout.json',{'ok':False,'reason':'six-minute acceptance timeout',
+                                      'progress':self.progress})
+        os._exit(21)
+
+
+def attach_acceptance(ctl,app,user):
+    return Acceptance(ctl,app,user)
