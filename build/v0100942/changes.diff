+            payload = {"ok": False, "app_version": self.app_version, "failed_step": self._startup_state,
+                       "reason": str(reason), "startup_trace": trace}
+            with zipfile.ZipFile(target, "x", zipfile.ZIP_DEFLATED) as zf:
+                zf.writestr("startup_failure.json", json.dumps(payload, ensure_ascii=False, indent=2))
+            report = str(target)
+        except Exception as exc:
+            reason = str(reason) + "; failure ZIP error: " + str(exc)
+        self._progress(0, "启动失败：" + str(reason))
+        self._emit_finished_once(False, report, "启动失败，已停止测试：" + str(reason))
