+class AbilityAuraOverlay(QWidget):
+    """Very light cosmetic aura driven only by XiaoMeili ability switches."""
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents, True)
+        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground, True)
+        self._states = {}
+        self._phase = 0.0
+        self._timer = QTimer(self)
+        self._timer.setInterval(45)
+        self._timer.timeout.connect(self._tick)
+        self._timer.start()
+        self.hide()
+
+    def set_states(self, states):
+        self._states = dict(states or {})
+        active = any(bool(v) for v in self._states.values())
+        self.setVisible(active)
+        if active:
+            self.raise_()
+        self.update()
+
+    def _tick(self):
+        if not self.isVisible():
+            return
+        self._phase = (self._phase + 0.045) % 1.0
+        self.update()
+
+    def paintEvent(self, event):
+        if not any(bool(v) for v in self._states.values()):
+            return
+        p = QPainter(self)
+        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
+        w, h = self.width(), self.height()
+        pulse = 0.5 + 0.5 * __import__('math').sin(self._phase * 6.283185307)
+
+        strength = 0.18
+        if self._states.get('power_20'):
+            strength = max(strength, 0.34)
+        if self._states.get('power_50'):
+            strength = max(strength, 0.58)
+        if self._states.get('beauty_god'):
+            strength = 1.0
+
+        # Peripheral halo. Keep the face/body itself untouched.
+        aura_rect = QRectF(w * 0.12, h * 0.055, w * 0.76, h * 0.90)
+        for extra, alpha, width in ((11, 20, 7), (6, 34, 4), (0, 95, 1.6)):
+            rr = aura_rect.adjusted(-extra, -extra, extra, extra)
+            pen = QPen(QColor(59, 239, 181, int(alpha * strength * (0.72 + pulse * 0.28))))
+            pen.setWidthF(float(width))
+            p.setPen(pen); p.setBrush(Qt.BrushStyle.NoBrush)
+            p.drawEllipse(rr)
+
+        if self._states.get('beauty_lock'):
+            # Restrained lock glow around the upper body, not a gameplay reticle.
+            lock_rect = QRectF(w * 0.28, h * 0.11, w * 0.44, h * 0.44)
+            pen = QPen(QColor(126, 255, 219, int(70 + pulse * 75)))
+            pen.setWidthF(1.4); p.setPen(pen); p.setBrush(Qt.BrushStyle.NoBrush)
+            p.drawEllipse(lock_rect)
+
+        if self._states.get('beauty_insight'):
+            # A scan shimmer clipped to XiaoMeili's own canvas only.
+            y = int(h * (0.19 + 0.58 * self._phase))
+            grad_alpha = int(45 + pulse * 65)
+            pen = QPen(QColor(83, 249, 194, grad_alpha)); pen.setWidthF(1.2)
+            p.setPen(pen)
+            p.drawLine(int(w * 0.20), y, int(w * 0.80), y)
+
+        if self._states.get('beauty_god'):
+            # Sparse particles around the edge. No fullscreen/game overlay.
+            import math
+            p.setPen(Qt.PenStyle.NoPen)
+            for i in range(8):
+                a = self._phase * 6.283185307 + i * (6.283185307 / 8.0)
+                x = w * 0.50 + math.cos(a) * w * 0.38
+                y = h * 0.49 + math.sin(a * 1.07) * h * 0.42
+                r = 1.4 + ((i % 3) * 0.45)
+                p.setBrush(QColor(104, 255, 211, int(75 + pulse * 95)))
+                p.drawEllipse(QPointF(float(x), float(y)), r, r)
+        p.end()
+
